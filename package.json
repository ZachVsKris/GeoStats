    "test-importers": "python scripts/test-data-pipeline.py && python scripts/test-world-bank-catalog-importer.py && python scripts/test-who-importer.py && python scripts/test-unesco-importer.py && python scripts/test-ilostat-importer.py && python scripts/test-natural-earth-importer.py && python scripts/test-comtrade-importer.py && python scripts/test-eia-importer.py && python scripts/test-unhcr-importer.py && python scripts/test-faostat-importer.py && npm run test-additional-importers",
    "test-player-links": "python scripts/test-player-source-links.py",
    "test-source-integrity": "python scripts/test-source-integrity.py",
    "verify-worldbank": "node scripts/verify-worldbank.mjs",
    "import-world-bank-catalog": "python scripts/import-world-bank-catalog.py --target-successes 500 --scan-limit 2000 --minimum-successes 100",
    "import-faostat": "python scripts/import-faostat.py",
    "import-who": "python scripts/import-who.py",
    "import-unesco": "python scripts/import-unesco.py",
    "import-ilostat": "python scripts/import-ilostat.py",
    "import-natural-earth": "python scripts/import-natural-earth.py",
    "import-comtrade": "python scripts/import-comtrade.py",
    "import-eia": "python scripts/import-eia.py",
    "import-unhcr": "python scripts/import-unhcr.py",
    "audit-source-integrity": "python scripts/audit-source-integrity.py --source all",
    "audit-player-links": "python scripts/audit-player-source-links.py",
    "seed-capacity": "node scripts/seed-capacity-help.mjs",
    "sync-visible-workflows": "python scripts/sync-visible-workflows.py",
    "test-v15": "npm run test-v15-7",
    "check-v15": "npm run check-v15-7",
    "import-pew-religion": "python scripts/import-pew-religion.py",
    "import-smithsonian-volcanoes": "python scripts/import-smithsonian-volcanoes.py",
    "import-usgs-earthquakes": "python scripts/import-usgs-earthquakes.py",
    "import-physical-summaries": "python scripts/import-physical-summaries.py",
    "typecheck": "tsc --noEmit",
    "test-v15-7": "node scripts/test-v15-7-clean.cjs && node scripts/test-v15-7-generator.cjs",
    "check-v15-7": "npm run test-v15-7 && npm run typecheck && npm run build",
    "test-additional-importers": "python scripts/test-pew-religion-importer.py && python scripts/test-smithsonian-volcano-importer.py && python scripts/test-usgs-earthquake-importer.py && python scripts/test-physical-summary-importer.py"
